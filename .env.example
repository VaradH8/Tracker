# Copy to .env (root) and fill in. Portainer reads these via the stack's
# Environment Variables panel — same key names. compose.yml expands them.

# --- Database (Postgres in the same compose stack) ---
POSTGRES_DB=tracker
POSTGRES_USER=tracker
# Required. Pick something long; this protects the DB inside the container
# network. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-me-with-a-strong-secret

# --- App ---
# Host port the app listens on. Caddy / nginx in front would proxy to this.
APP_PORT=3000

# Set to 1 on the very first boot to seed the demo accounts (varad@…,
# manasi@…, etc., password = tracker2026). Set back to 0 afterwards so
# subsequent restarts don't wipe live data.
RUN_SEED=0
