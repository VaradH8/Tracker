# Copy to .env (root) and fill in. Portainer reads these via the stack's
# Environment Variables panel — same key names. compose.yml expands them.

# --- Database (Postgres in the same compose stack) ---
POSTGRES_DB=tracker
POSTGRES_USER=tracker
# Required. Pick something long; this protects the DB inside the container
# network. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=tracker_pw_pick_anything

# --- App ---
# Public hostname (the URL users hit). Traefik routes this hostname to
# the app container and serves it over HTTPS using a Let's Encrypt cert.
PUBLIC_HOST=tracker.inventivebizsol.co.in

# Set to 1 on the very first boot to seed the demo accounts (varad@…,
# manasi@…, etc., password = tracker2026). Set back to 0 afterwards so
# subsequent restarts don't wipe live data.
RUN_SEED=0

# --- SMTP (real outbound email) ---
# Leave these blank to keep email-as-DB-row behaviour: notification +
# password-reset rows still land in EmailLog, but no actual email is
# sent. As soon as you set HOST/USER/PASS/FROM the app starts sending
# for real. Works with SES, SendGrid, Postmark, Mailgun, Resend, any
# SMTP relay.
SMTP_HOST=
SMTP_PORT=587
# 1 = implicit TLS (port 465), 0 = STARTTLS (port 587). Auto-detected
# from the port if unset.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# What the "From" header shows. Some providers require this to be a
# pre-verified address.
SMTP_FROM=no-reply@example.com

# --- Off-host backups (optional) ---
# The pg_backup sidecar writes nightly dumps to ./backups/ on the host.
# To copy them off-host, fill in the rclone vars below and the
# rclone_backup sidecar will rsync them every hour to your chosen
# remote. Leave blank to skip the off-host copy (you'll need to do it
# manually via cron + scp).
#
# Example for S3-compatible Backblaze B2:
#   RCLONE_CONFIG_REMOTE_TYPE=s3
#   RCLONE_CONFIG_REMOTE_PROVIDER=Other
#   RCLONE_CONFIG_REMOTE_ENDPOINT=s3.us-west-002.backblazeb2.com
#   RCLONE_CONFIG_REMOTE_ACCESS_KEY_ID=...
#   RCLONE_CONFIG_REMOTE_SECRET_ACCESS_KEY=...
#   RCLONE_BACKUP_DEST=remote:tracker-backups
RCLONE_CONFIG_REMOTE_TYPE=
RCLONE_CONFIG_REMOTE_PROVIDER=
RCLONE_CONFIG_REMOTE_ENDPOINT=
RCLONE_CONFIG_REMOTE_ACCESS_KEY_ID=
RCLONE_CONFIG_REMOTE_SECRET_ACCESS_KEY=
RCLONE_BACKUP_DEST=
