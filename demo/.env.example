# Demo mode controls whether the in-app role switcher is visible.
# Set to "1" or "true" for internal demos / leadership previews.
# Leave unset (or "0") for the production build — the role switcher
# disappears, leaving the login role picker as the only entry point.
NEXT_PUBLIC_DEMO_MODE=

# Public site URL — used by sitemap.xml. Set to your real domain on Vercel.
NEXT_PUBLIC_SITE_URL=
