# --- Database ---
# Local dev uses SQLite (file:./dev.db).
# Production: provision Postgres (Neon / Supabase / Vercel Postgres) and
# also flip prisma/schema.prisma `provider = "sqlite"` to `"postgresql"`.
DATABASE_URL="file:./dev.db"

# --- Auth (NextAuth v5) ---
# Generate with: openssl rand -hex 32
AUTH_SECRET=
# When deployed behind a proxy (e.g. Vercel), set this to true.
AUTH_TRUST_HOST=true

# Public site URL — used by sitemap.xml. Set to your real domain on Vercel.
NEXT_PUBLIC_SITE_URL=
