generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  primaryRole     String
  isAdmin         Boolean   @default(false)
  isActive        Boolean   @default(true)
  designation     String?
  phone           String?
  location        String?
  joined          DateTime?
  lastLoginAt     DateTime?
  hourlyRate      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Performance / efficiency signals
  hoursLast7      Int       @default(0)
  hoursLast30     Int       @default(0)
  capacityPerWeek Int       @default(40)
  tasksDone30     Int       @default(0)
  estimateAccuracy Int      @default(100)
  performance     String    @default("On track")
  flags           String    @default("[]")

  sessions              Session[]
  taskAssignments       TaskAssignee[]
  tasksResponsibleFor   Task[]         @relation("TaskResponsible")
  tasksApproved         Task[]         @relation("TaskApprover")
  projectsLed           Project[]      @relation("ProjectLead")
  projectMemberships    ProjectMember[]
  remarksAuthored       Remark[]
  attachmentsUploaded   TaskAttachment[]
  timeEntries           TimeEntry[]
  auditLog              AuditEntry[]   @relation("AuditActor")
  notifications         Notification[]
  emailsReceived        EmailLog[]
  leaves                Leave[]
}

/// Server-side session — the cookie holds the session id; the DB row owns
/// the truth. Revoking = deleting the row.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id              Int       @id @default(autoincrement())
  name            String
  industry        String
  primaryContact  String
  email           String
  since           DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  projects        Project[]
}

model Project {
  id              Int       @id @default(autoincrement())
  name            String
  clientId        Int
  client          Client    @relation(fields: [clientId], references: [id])
  status          String
  coordinatorName String
  bdName          String
  leadId          String?
  lead            User?     @relation("ProjectLead", fields: [leadId], references: [id])
  startDate       DateTime
  targetDate      DateTime
  budgetHours     Int
  loggedHours     Int       @default(0)
  progress        Int       @default(0)
  health          String    @default("green")
  description     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  members         ProjectMember[]
  tasks           Task[]
}

/// Project team-members roster. Independent of who happens to have a task
/// today — gives new joiners visibility before any task lands on them.
model ProjectMember {
  projectId  Int
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([projectId, userId])
}

model Task {
  id              Int       @id @default(autoincrement())
  title           String
  description     String?
  projectId       Int
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  priority        String
  status          String    @default("To Do")
  startDate       DateTime?
  targetDate      DateTime
  estimatedHours  Float?
  actualHours     Float?
  important       Boolean   @default(false)
  overdueDays     Int?

  // Person Responsible: the user who created / assigned this task (singular).
  // Person Accountable: the users actually performing it (many) — see TaskAssignee.
  responsibleId   String?
  responsible     User?     @relation("TaskResponsible", fields: [responsibleId], references: [id])

  // Sign-off for Done tasks — set when Lead/Responsible/Coord approves.
  approvedById    String?
  approvedBy      User?     @relation("TaskApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assignees       TaskAssignee[]
  remarks         Remark[]
  attachments     TaskAttachment[]
  timeEntries     TimeEntry[]
  blockedBy       TaskDependency[] @relation("TaskBlockedBy")
  blocks          TaskDependency[] @relation("TaskBlocks")
}

model TaskAssignee {
  taskId          Int
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())

  @@id([taskId, userId])
}

/// "Task A is blocked by Task B" — A's blockedBy includes B; B's blocks
/// includes A. Picker only allows same-project tasks at the API layer.
model TaskDependency {
  blockedTaskId  Int
  blockedTask    Task  @relation("TaskBlockedBy", fields: [blockedTaskId], references: [id], onDelete: Cascade)
  blockerTaskId  Int
  blockerTask    Task  @relation("TaskBlocks", fields: [blockerTaskId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@id([blockedTaskId, blockerTaskId])
}

model TaskAttachment {
  id            Int      @id @default(autoincrement())
  taskId        Int
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name          String
  size          String
  kind          String   @default("other")
  uploadedById  String?
  uploadedBy    User?    @relation(fields: [uploadedById], references: [id])
  storageKey    String?
  createdAt     DateTime @default(now())
}

model TimeEntry {
  id        Int      @id @default(autoincrement())
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  hours     Float
  note      String?
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([userId, date])
}

model Remark {
  id              Int       @id @default(autoincrement())
  taskId          Int
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId        String
  author          User      @relation(fields: [authorId], references: [id])
  body            String
  createdAt       DateTime  @default(now())
}

model AuditEntry {
  id              Int       @id @default(autoincrement())
  actorId         String
  actor           User      @relation("AuditActor", fields: [actorId], references: [id])
  action          String
  scope           String?
  taskTitle       String?
  before          String?
  after           String?
  createdAt       DateTime  @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id              Int       @id @default(autoincrement())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            String
  title           String
  body            String
  taskId          Int?
  isRead          Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([userId, isRead])
}

/// Mirror of every in-app notification that "would have been emailed" —
/// captured here for the Settings → Email log view. Persisted so admins
/// can audit delivery, even if the SMTP send itself fails later.
model EmailLog {
  id          Int      @id @default(autoincrement())
  recipientId String?
  recipient   User?    @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  toEmail     String
  subject     String
  body        String
  kind        String
  taskId      Int?
  createdAt   DateTime @default(now())

  @@index([recipientId])
}

model Leave {
  id              Int       @id @default(autoincrement())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  start           DateTime
  end             DateTime
  type            String
  note            String?
  approved        Boolean   @default(false)
  createdAt       DateTime  @default(now())
}

model PipelineDeal {
  id              Int       @id @default(autoincrement())
  name            String
  clientName      String
  estimatedValue  Int       @default(0)
  probability     Int       @default(20)
  stage           String    @default("Lead")
  expectedStart   DateTime?
  bdName          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
