generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  primaryRole  String
  isAdmin      Boolean   @default(false)
  isActive     Boolean   @default(true)
  designation  String?
  phone        String?
  location     String?
  joined       DateTime?
  lastLoginAt  DateTime?
  hourlyRate   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Performance / efficiency signals
  hoursLast7       Int    @default(0)
  hoursLast30      Int    @default(0)
  capacityPerWeek  Int    @default(40)
  tasksDone30      Int    @default(0)
  estimateAccuracy Int    @default(100)
  performance      String @default("On track")
  flags            String @default("[]")

  sessions            Session[]
  passwordResets      PasswordResetToken[]
  taskAssignments     TaskAssignee[]
  tasksResponsibleFor Task[]               @relation("TaskResponsible")
  tasksApproved       Task[]               @relation("TaskApprover")
  projectMemberships  ProjectMember[]
  remarksAuthored     Remark[]
  attachmentsUploaded TaskAttachment[]
  timeEntries         TimeEntry[]
  auditLog            AuditEntry[]         @relation("AuditActor")
  notifications       Notification[]
  emailsReceived      EmailLog[]
  leaves              Leave[]
}

/// One-time password-reset token. Issued by /api/auth/forgot-password
/// and consumed by /api/auth/reset-password. The token id is what goes
/// in the user's URL; it's also the lookup key. Single-use: once
/// `usedAt` is set the row stays around (for audit) but can't be
/// reused.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Server-side session — the cookie holds the session id; the DB row owns
/// the truth. Revoking = deleting the row.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id             Int      @id @default(autoincrement())
  name           String
  industry       String
  primaryContact String
  email          String
  since          DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projects Project[]
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id])
  status      String
  startDate   DateTime
  targetDate  DateTime
  budgetHours Int
  loggedHours Int      @default(0)
  progress    Int      @default(0)
  health      String   @default("green")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members ProjectMember[]
  tasks   Task[]
}

/// Per-project role assignment. One row per (project, user, role) so the
/// same person can be both Lead and Developer on the same project. A user
/// sees a project iff they have at least one row here (admins see all).
model ProjectMember {
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("Developer")
  createdAt DateTime @default(now())

  @@id([projectId, userId, role])
  @@index([userId])
}

model Task {
  id             Int       @id @default(autoincrement())
  title          String
  description    String?
  projectId      Int
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  priority       String
  status         String    @default("To Do")
  startDate      DateTime?
  targetDate     DateTime
  estimatedHours Float?
  actualHours    Float?
  important      Boolean   @default(false)
  overdueDays    Int?

  // Person Responsible: the user who created / assigned this task (singular).
  // Person Accountable: the users actually performing it (many) — see TaskAssignee.
  responsibleId String?
  responsible   User?   @relation("TaskResponsible", fields: [responsibleId], references: [id])

  // Sign-off for Done tasks — set when Lead/Responsible/Coord approves.
  approvedById String?
  approvedBy   User?     @relation("TaskApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignees   TaskAssignee[]
  remarks     Remark[]
  attachments TaskAttachment[]
  timeEntries TimeEntry[]
  blockedBy   TaskDependency[] @relation("TaskBlockedBy")
  blocks      TaskDependency[] @relation("TaskBlocks")
}

model TaskAssignee {
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([taskId, userId])
}

/// "Task A is blocked by Task B" — A's blockedBy includes B; B's blocks
/// includes A. Picker only allows same-project tasks at the API layer.
model TaskDependency {
  blockedTaskId Int
  blockedTask   Task     @relation("TaskBlockedBy", fields: [blockedTaskId], references: [id], onDelete: Cascade)
  blockerTaskId Int
  blockerTask   Task     @relation("TaskBlocks", fields: [blockerTaskId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@id([blockedTaskId, blockerTaskId])
}

model TaskAttachment {
  id           Int      @id @default(autoincrement())
  taskId       Int
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name         String
  size         String
  kind         String   @default("other")
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  storageKey   String?
  createdAt    DateTime @default(now())
}

/// Time spent on a task. Two shapes:
///   - Timer entry: startedAt set, endedAt null while running. When the
///     user clicks Stop / Done we set endedAt + compute hours.
///   - Manual entry (legacy/admin correction): hours set directly,
///     startedAt/endedAt null.
/// `hours` is the canonical "billable time" once finalised.
model TimeEntry {
  id        Int       @id @default(autoincrement())
  taskId    Int
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  hours     Float?
  note      String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([taskId])
  @@index([userId, date])
  @@index([userId, endedAt])
}

model Remark {
  id        Int      @id @default(autoincrement())
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model AuditEntry {
  id        Int      @id @default(autoincrement())
  // Actor is nullable so deleting a user doesn't blow away the
  // audit trail of what they did. The row stays; the actor field
  // becomes null and the UI falls back to "(removed user)".
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  scope     String?
  taskTitle String?
  before    String?
  after     String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String
  taskId    Int?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

/// Mirror of every in-app notification that "would have been emailed" —
/// captured here for the Settings → Email log view. Persisted so admins
/// can audit delivery, even if the SMTP send itself fails later.
model EmailLog {
  id          Int      @id @default(autoincrement())
  recipientId String?
  recipient   User?    @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  toEmail     String
  subject     String
  body        String
  kind        String
  taskId      Int?
  createdAt   DateTime @default(now())

  @@index([recipientId])
}

model Leave {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  start     DateTime
  end       DateTime
  type      String
  note      String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PipelineDeal {
  id             Int       @id @default(autoincrement())
  name           String
  clientName     String
  estimatedValue Int       @default(0)
  probability    Int       @default(20)
  stage          String    @default("Lead")
  expectedStart  DateTime?
  bdName         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/* ====================================================================
   Domain module — a separate, self-contained mini-app living inside the
   same database but sharing NOTHING with the tracker tables above.
   Roles: Admin / Lead / TeamLead / Actionee. Its own accounts, sessions,
   projects, tasks and daily work logs.
   ==================================================================== */

model DomainUser {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("Actionee") // Admin | Lead | TeamLead | Actionee
  dailyCapacity Int      @default(8) // hours/day used for availability math
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      DomainSession[]
  projectsOwned DomainProject[] @relation("DomainProjectOwner")
  tasksAssigned DomainTask[]    @relation("DomainTaskAssignee")
  tasksCreated  DomainTask[]    @relation("DomainTaskCreator")
  workLogs      DomainWorkLog[]
}

model DomainSession {
  id        String     @id @default(cuid())
  userId    String
  user      DomainUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([userId])
}

model DomainProject {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  ownerId     String
  owner       DomainUser @relation("DomainProjectOwner", fields: [ownerId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tasks    DomainTask[]
  workLogs DomainWorkLog[]

  @@index([ownerId])
}

model DomainTask {
  id          Int           @id @default(autoincrement())
  projectId   Int
  project     DomainProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String        @default("To Do") // To Do | In Progress | Done
  assigneeId  String?
  assignee    DomainUser?   @relation("DomainTaskAssignee", fields: [assigneeId], references: [id])
  createdById String
  createdBy   DomainUser    @relation("DomainTaskCreator", fields: [createdById], references: [id])
  targetDate  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workLogs DomainWorkLog[]

  @@index([projectId])
  @@index([assigneeId])
}

model DomainWorkLog {
  id        Int            @id @default(autoincrement())
  userId    String
  user      DomainUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId Int?
  project   DomainProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId    Int?
  task      DomainTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  date      DateTime // the IST day this log is for (midnight UTC of that date)
  hours     Float
  note      String
  createdAt DateTime       @default(now())

  @@index([userId, date])
}
