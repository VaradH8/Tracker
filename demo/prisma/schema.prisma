generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  primaryRole  String
  isAdmin      Boolean   @default(false)
  isActive     Boolean   @default(true)
  designation  String?
  phone        String?
  location     String?
  joined       DateTime?
  lastLoginAt  DateTime?
  hourlyRate   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Performance / efficiency signals
  hoursLast7       Int    @default(0)
  hoursLast30      Int    @default(0)
  capacityPerWeek  Int    @default(40)
  tasksDone30      Int    @default(0)
  estimateAccuracy Int    @default(100)
  performance      String @default("On track")
  flags            String @default("[]")

  sessions            Session[]
  passwordResets      PasswordResetToken[]
  taskAssignments     TaskAssignee[]
  tasksResponsibleFor Task[]               @relation("TaskResponsible")
  tasksApproved       Task[]               @relation("TaskApprover")
  projectMemberships  ProjectMember[]
  remarksAuthored     Remark[]
  attachmentsUploaded TaskAttachment[]
  timeEntries         TimeEntry[]
  auditLog            AuditEntry[]         @relation("AuditActor")
  notifications       Notification[]
  emailsReceived      EmailLog[]
  leaves              Leave[]
}

/// One-time password-reset token. Issued by /api/auth/forgot-password
/// and consumed by /api/auth/reset-password. The token id is what goes
/// in the user's URL; it's also the lookup key. Single-use: once
/// `usedAt` is set the row stays around (for audit) but can't be
/// reused.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Server-side session — the cookie holds the session id; the DB row owns
/// the truth. Revoking = deleting the row.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id             Int      @id @default(autoincrement())
  name           String
  industry       String
  primaryContact String
  email          String
  since          DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projects Project[]
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id])
  status      String
  startDate   DateTime
  targetDate  DateTime
  budgetHours Int
  loggedHours Int      @default(0)
  progress    Int      @default(0)
  health      String   @default("green")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members ProjectMember[]
  tasks   Task[]
}

/// Per-project role assignment. One row per (project, user, role) so the
/// same person can be both Lead and Developer on the same project. A user
/// sees a project iff they have at least one row here (admins see all).
model ProjectMember {
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("Developer")
  createdAt DateTime @default(now())

  @@id([projectId, userId, role])
  @@index([userId])
}

model Task {
  id             Int       @id @default(autoincrement())
  title          String
  description    String?
  projectId      Int
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  priority       String
  status         String    @default("To Do")
  startDate      DateTime?
  targetDate     DateTime
  estimatedHours Float?
  actualHours    Float?
  important      Boolean   @default(false)
  overdueDays    Int?

  // Set when the task is first moved to Done; cleared if it's reopened.
  // Drives which ISO week a completed task settles into on the weekly
  // board — a finished task shows in the week it was completed, not its
  // target week, and never carries forward.
  completedAt    DateTime?

  // Person Responsible: the user who created / assigned this task (singular).
  // Person Accountable: the users actually performing it (many) — see TaskAssignee.
  responsibleId String?
  responsible   User?   @relation("TaskResponsible", fields: [responsibleId], references: [id])

  // Sign-off for Done tasks — set when Lead/Responsible/Coord approves.
  approvedById String?
  approvedBy   User?     @relation("TaskApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  /// Fork lineage. A fork is an independent copy of someone else's task,
  /// owned by whoever forked it — the original keeps its own assignees and
  /// is never modified. Null on a task that was created outright.
  /// SetNull rather than Cascade: deleting an original must not delete the
  /// work someone else did off the back of it.
  forkedFromId Int?
  forkedFrom   Task?     @relation("TaskForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks        Task[]    @relation("TaskForks")
  forkedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignees   TaskAssignee[]
  remarks     Remark[]
  attachments TaskAttachment[]
  timeEntries TimeEntry[]
  blockedBy   TaskDependency[] @relation("TaskBlockedBy")
  blocks      TaskDependency[] @relation("TaskBlocks")

  @@index([forkedFromId])
}

model TaskAssignee {
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([taskId, userId])
}

/// "Task A is blocked by Task B" — A's blockedBy includes B; B's blocks
/// includes A. Picker only allows same-project tasks at the API layer.
model TaskDependency {
  blockedTaskId Int
  blockedTask   Task     @relation("TaskBlockedBy", fields: [blockedTaskId], references: [id], onDelete: Cascade)
  blockerTaskId Int
  blockerTask   Task     @relation("TaskBlocks", fields: [blockerTaskId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@id([blockedTaskId, blockerTaskId])
}

model TaskAttachment {
  id           Int      @id @default(autoincrement())
  taskId       Int
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name         String
  size         String
  kind         String   @default("other")
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  storageKey   String?
  createdAt    DateTime @default(now())
}

/// Time spent on a task. Two shapes:
///   - Timer entry: startedAt set, endedAt null while running. When the
///     user clicks Stop / Done we set endedAt + compute hours.
///   - Manual entry (legacy/admin correction): hours set directly,
///     startedAt/endedAt null.
/// `hours` is the canonical "billable time" once finalised.
model TimeEntry {
  id        Int       @id @default(autoincrement())
  taskId    Int
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  hours     Float?
  note      String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([taskId])
  @@index([userId, date])
  @@index([userId, endedAt])
}

model Remark {
  id        Int      @id @default(autoincrement())
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model AuditEntry {
  id        Int      @id @default(autoincrement())
  // Actor is nullable so deleting a user doesn't blow away the
  // audit trail of what they did. The row stays; the actor field
  // becomes null and the UI falls back to "(removed user)".
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  scope     String?
  taskTitle String?
  before    String?
  after     String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String
  taskId    Int?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

/// Mirror of every in-app notification that "would have been emailed" —
/// captured here for the Settings → Email log view. Persisted so admins
/// can audit delivery, even if the SMTP send itself fails later.
model EmailLog {
  id          Int      @id @default(autoincrement())
  recipientId String?
  recipient   User?    @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  toEmail     String
  subject     String
  body        String
  kind        String
  taskId      Int?
  createdAt   DateTime @default(now())

  @@index([recipientId])
}

model Leave {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  start     DateTime
  end       DateTime
  type      String
  note      String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Org-wide configuration, edited by admins on the Settings page. A
/// single-row table (id is always 1). CSV columns keep it simple — the
/// app splits workingDays / leaveTypes on read.
model AppSettings {
  id                 Int      @id @default(1)
  smtpFrom           String?
  workingHoursPerDay Int      @default(8)
  workingDays        String   @default("Mon,Tue,Wed,Thu,Fri")
  leaveTypes         String   @default("Sick Leave,Casual Leave,Paid Leave,Unpaid Leave")
  annualLeaveQuota   Int      @default(12)
  updatedAt          DateTime @updatedAt
}

model PipelineDeal {
  id             Int       @id @default(autoincrement())
  name           String
  clientName     String
  estimatedValue Int       @default(0)
  probability    Int       @default(20)
  stage          String    @default("Lead")
  expectedStart  DateTime?
  bdName         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/* ====================================================================
   Domain module — a separate, self-contained mini-app living inside the
   same database but sharing NOTHING with the tracker tables above.
   Roles: Admin / Lead / TeamLead / Actionee. Its own accounts, sessions,
   projects, tasks and daily work logs.
   ==================================================================== */

model DomainUser {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("Actionee") // Admin | Lead | TeamLead | Actionee
  /// Unused. The module plans in tags/day, not hours, so nothing reads or
  /// writes this. Kept only because dropping a column is destructive
  /// (CLAUDE.md rule 9) — remove it in a deliberate migration once you are
  /// sure no environment still needs the values.
  dailyCapacity Int      @default(8)
  /// Expected tags/day for this person, set by a Lead when they're added.
  /// Used for forecasting until they have approved history of their own,
  /// at which point the measured rate takes over. Null = use the house
  /// default.
  expectedTagsPerDay Float?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      DomainSession[]
  /// The employee record for this person, where HR has made one. Optional
  /// in both directions: most employees never get a login, and an account
  /// can exist before HR files the paperwork.
  employee      DomainEmployee? @relation("DomainEmployeeAccount")
  projectsOwned DomainProject[] @relation("DomainProjectOwner")
  tasksAssigned DomainTask[]    @relation("DomainTaskAssignee")
  tasksCreated  DomainTask[]    @relation("DomainTaskCreator")
  tasksReviewed DomainTask[]    @relation("DomainTaskReviewer")
  taskEvents    DomainTaskEvent[] @relation("DomainTaskEventActor")
  workLogs      DomainWorkLog[]

  allocations         DomainAllocation[]    @relation("DomainAllocationUser")
  allocationsCreated  DomainAllocation[]    @relation("DomainAllocationCreator")
  tagAssignments      DomainTagAssignment[] @relation("DomainTagAssignee")
  tagAssignmentsMade  DomainTagAssignment[] @relation("DomainTagAssignmentCreator")
  tagSubmissions      DomainTagSubmission[] @relation("DomainTagSubmitter")
  deliveryCorrections DomainDeliveryCorrection[] @relation("DomainDeliveryCorrector")
  tagAssignmentsRemoved DomainTagAssignment[] @relation("DomainTagAssignmentRemover")
  tagReviews          DomainTagSubmission[] @relation("DomainTagReviewer")
  /// Hide everything but the Task log for this person.
  ///
  /// A display preference, stored on the user rather than in the browser
  /// so it follows them to a second machine — somebody who only ever uses
  /// this app for tasks should not have to set that up again on the site
  /// office PC. It hides nav entries and nothing else: every permission
  /// check is unchanged, because a preference must never be load-bearing
  /// for access.
  taskLogOnly         Boolean               @default(false)
  /// People this person names as reviewers by default when raising a task.
  defaultReviewers    DomainDefaultReviewer[] @relation("DefaultReviewerOwner")
  /// The other side: tasks where somebody else has named THEM a default.
  /// Present so deleting an account takes its standing nominations with
  /// it rather than leaving ids that pre-fill a person who is gone.
  defaultReviewerFor  DomainDefaultReviewer[] @relation("DefaultReviewerPerson")
  taskReviews         DomainTaskReviewer[]  @relation("DomainTaskReviewerUser")
  tasksEdited         DomainTask[]          @relation("DomainTaskEditor")
  taskFilesUploaded   DomainTaskAttachment[] @relation("DomainTaskAttachmentUploader")
  leaveRecords   DomainLeave[] @relation("DomainLeaveSubject")
  leavesAuthored DomainLeave[] @relation("DomainLeaveAuthor")
  leavesDecided  DomainLeave[] @relation("DomainLeaveDecider")
}

/// A person on the payroll, kept by HR. Deliberately NOT a login: most of
/// the people on this list never sign in, and an account is a separate
/// thing that can be attached later through `userId`. Keeping them apart
/// means HR can onboard somebody on their first day without minting
/// credentials, and deactivating an account never erases the person.
model DomainEmployee {
  id          Int       @id @default(autoincrement())
  /// Staff number. Unique, and the handle HR actually uses day to day.
  code        String    @unique
  name        String
  designation String?
  department  String?
  email       String?
  phone       String?
  location    String?
  joinedOn    DateTime?
  isActive    Boolean   @default(true)

  /// Optional link to a login account. SetNull, not Cascade: deleting an
  /// account must never delete the employee record behind it.
  userId String?     @unique
  user   DomainUser? @relation("DomainEmployeeAccount", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model DomainSession {
  id        String     @id @default(cuid())
  userId    String
  user      DomainUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([userId])
}

model DomainProject {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  ownerId     String
  owner       DomainUser @relation("DomainProjectOwner", fields: [ownerId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Forecast inputs. totalTags is the whole deliverable for the project;
  // handoverDate is the date it's promised to the client. Both optional so
  // projects created before the forecast feature keep working.
  startDate    DateTime?
  handoverDate DateTime?

  /// What the client has actually handed over for us to work on. This is
  /// the denominator for delivery: you cannot deliver a tag you have not
  /// been given.
  totalTags    Int       @default(0)

  /// The whole scope agreed with the client, which is usually larger than
  /// what has been released to us so far. Nullable because plenty of
  /// projects are run without tracking the contract separately, and a
  /// zero would be indistinguishable from "not tracked".
  ///
  /// Tags still sitting with the client are derived (contract − received)
  /// rather than stored: two numbers that must agree are one number too
  /// many, and the stored pair would drift the first time either changed.
  contractTags Int?

  // How the handover date was arrived at, kept so it can be recalculated
  // when a holiday is added or the schedule shifts. Both nullable: a
  // handover date typed in directly stays perfectly valid, and every
  // project created before this existed has one.
  //   workingDaysPerWeek — 5 (Mon-Fri) or 6 (Mon-Sat)
  //   totalWorkingDays   — the figure the date was derived from
  workingDaysPerWeek Int?
  totalWorkingDays   Int?
  /// Who the work is for. A plain name, deliberately NOT a link to the
  /// tracker's Client table — the Domain module stays self-contained.
  /// Shown to actionees so they know whose work they're holding.
  client       String?

  tasks    DomainTask[]
  workLogs DomainWorkLog[]

  divisions      DomainProjectDivision[]
  allocations    DomainAllocation[]
  tagAssignments DomainTagAssignment[]

  @@index([ownerId])
}

/// A discipline a project's tags belong to (Electrical, Piping, …). Global
/// catalogue so the same name means the same thing across projects; Leads
/// attach the ones a project actually uses via DomainProjectDivision.
model DomainDivision {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  projects       DomainProjectDivision[]
  tagAssignments DomainTagAssignment[]
  tasks          DomainTask[]
}

/// Join between a project and a division it uses, carrying that division's
/// share of the tag count.
model DomainProjectDivision {
  id         Int            @id @default(autoincrement())
  projectId  Int
  project    DomainProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  divisionId Int
  division   DomainDivision @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  totalTags  Int            @default(0)
  createdAt  DateTime       @default(now())

  @@unique([projectId, divisionId])
  @@index([divisionId])
}

/// A resource booked onto a project for a window of time. This is what the
/// forecast reads to answer "who is free, and from when" and what raises
/// the conflict prompt when the same person is booked twice over.
model DomainAllocation {
  id          Int           @id @default(autoincrement())
  projectId   Int
  project     DomainProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        DomainUser    @relation("DomainAllocationUser", fields: [userId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  /// Set when someone is let go of the project early — from this date they
  /// count as available even though endDate hasn't arrived.
  releasedAt  DateTime?
  /// What this person is expected to deliver per day *on this project*.
  /// The same person can be quick on one discipline and slow on another, so
  /// this beats both their measured average and their profile-level rate
  /// when forecasting this project. Null = fall back to those.
  expectedTagsPerDay Float?
  createdById String
  createdBy   DomainUser    @relation("DomainAllocationCreator", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
}

/// "100 Electrical tags on Project X to Mukesh." One row per
/// project+division+person; deliveredCount only ever moves on Lead approval.
model DomainTagAssignment {
  id             Int             @id @default(autoincrement())
  projectId      Int
  project        DomainProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  divisionId     Int?
  division       DomainDivision? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  assigneeId     String
  assignee       DomainUser      @relation("DomainTagAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assignedCount  Int
  deliveredCount Int             @default(0)
  /// How hard this batch is: "Simple" or "Complex". Defaults to Simple so
  /// an unanswered dropdown, and every row that predates the field, mean
  /// the same thing. Recorded for reporting — it does not currently
  /// weight the forecast.
  complexity     String          @default("Simple")
  /// When this batch of tags should be worked and finished by. Separate
  /// from the project's own dates — one person's slice of a project often
  /// runs to a tighter date than the handover.
  startDate      DateTime?
  targetDate     DateTime?
  createdById    String
  createdBy      DomainUser      @relation("DomainTagAssignmentCreator", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  /// Set when somebody is taken off the project and their tags go with
  /// them. The row stays.
  ///
  /// It has to stay, because every submission hangs off it by a cascading
  /// foreign key — deleting the assignment would take the approval history
  /// with it, and the history is the one thing that must survive somebody
  /// leaving a project. So the row is marked instead: every screen that
  /// asks "what work is live" filters these out, and the Approvals history,
  /// which asks "what was decided", does not.
  removedAt      DateTime?
  removedById    String?
  removedBy      DomainUser?     @relation("DomainTagAssignmentRemover", fields: [removedById], references: [id], onDelete: SetNull)

  submissions DomainTagSubmission[]
  corrections DomainDeliveryCorrection[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([divisionId])
  @@index([removedAt])
}

/// An Admin's manual correction to a delivered count.
///
/// Delivery normally moves one way only: an actionee submits, a Lead
/// approves, the total goes up. That is what makes the number trustworthy,
/// and it is why nobody — not even an Admin — could edit it directly.
///
/// But a figure that cannot be corrected is not trustworthy either. Tags
/// delivered before the system existed, a batch approved twice, an import
/// that landed short: none of those can be fixed by approving something,
/// and until they are the whole portfolio reads wrong.
///
/// So an Admin can set the figure, and every time they do, a row lands
/// here: what it was, what they made it, why, and who. The delivered count
/// stays as auditable as it was — the audit just has two kinds of entry in
/// it now instead of one.
model DomainDeliveryCorrection {
  id           Int                 @id @default(autoincrement())
  assignmentId Int
  assignment   DomainTagAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// The delivered count before and after, kept as absolutes rather than a
  /// delta so a row still reads correctly beside later corrections.
  before       Int
  after        Int
  /// Required. A correction without a stated reason is indistinguishable
  /// from someone moving a number they did not like.
  reason       String
  /// Nullable so removing an account does not erase the history of what
  /// they changed — same rule as AuditEntry.
  actorId      String?
  actor        DomainUser?         @relation("DomainDeliveryCorrector", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())

  @@index([assignmentId])
  @@index([createdAt])
}

/// An actionee's end-of-day "I finished N tags", pending a Lead's review.
/// approvedCount is what the Lead actually signed off, which may be less
/// than the claimed completedCount.
model DomainTagSubmission {
  id             Int                 @id @default(autoincrement())
  assignmentId   Int
  assignment     DomainTagAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// The IST day the work is claimed for (midnight UTC of that date).
  date           DateTime
  completedCount Int
  status         String              @default("Pending") // Pending | Approved | Rejected
  approvedCount  Int?
  note           String?
  submittedById  String
  submittedBy    DomainUser          @relation("DomainTagSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedById   String?
  reviewedBy     DomainUser?         @relation("DomainTagReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([assignmentId, date])
  @@index([status])
  @@index([submittedById])
}

model DomainTask {
  id Int @id @default(autoincrement())

  /// Null for an ad-hoc task — work that belongs to nobody's project.
  /// Everything else hangs off a project, and optionally one of its
  /// divisions.
  projectId  Int?
  project    DomainProject?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  divisionId Int?
  division   DomainDivision? @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  title       String
  description String?
  status         String        @default("Assigned")
  assigneeId     String?
  assignee       DomainUser?   @relation("DomainTaskAssignee", fields: [assigneeId], references: [id])
  createdById    String
  createdBy      DomainUser    @relation("DomainTaskCreator", fields: [createdById], references: [id])
  startDate      DateTime?
  targetDate     DateTime? // the deadline
  /// What the assigner budgeted. Filled in from the dates at nine hours a
  /// working day (see lib/domain-task-hours) and editable — plenty of
  /// tasks are two hours inside a week-long window.
  estimatedHours Float?
  /// How urgent this is: Low, Medium or High.
  ///
  /// Medium by default rather than null, so every task sorts against every
  /// other one. A nullable priority splits a list into "ranked" and
  /// "unranked" the first time somebody sorts by it, and the unranked pile
  /// is always the older half.
  priority       String   @default("Medium")
  /// Whether the estimate counted the Saturdays and Sundays in the span.
  ///
  /// Stored rather than recomputed because it is the assigner's decision,
  /// not a property of the dates: the same Friday-to-Monday task is 9h for
  /// one team and 27h for another, and without this the reader of a 27h
  /// weekend task cannot tell whether somebody meant it or fat-fingered
  /// the number.
  includesWeekends Boolean @default(false)
  /// When the brief was last changed after it went out, and by whom.
  ///
  /// Recorded because the person doing the work read something, and an
  /// edit means what they read is no longer what they were asked for. The
  /// task says so on its face rather than changing under them silently.
  ///
  /// Null on a task nobody has touched since assigning it, which is most
  /// of them — the chip only appears when there is something to say.
  editedAt       DateTime?
  editedById     String?
  editedBy       DomainUser? @relation("DomainTaskEditor", fields: [editedById], references: [id], onDelete: SetNull)
  /// What the assignee reported having spent, given on submission.
  /// Optional: work gets done without anybody timing it, and refusing a
  /// submission for want of a number only teaches people to invent one.
  hoursSpent     Float?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  /// Filled in when the assignee submits the task for review: the day they
  /// did the work, their note, and when they pressed submit. Kept apart
  /// from `updatedAt` so a later edit doesn't disturb the submission record.
  submittedOn   DateTime?
  submittedNote String?
  submittedAt   DateTime?

  /// The decision by whoever assigned it. reviewedById stays null on a
  /// task nobody has decided yet.
  reviewedById String?
  reviewedBy   DomainUser? @relation("DomainTaskReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  workLogs    DomainWorkLog[]
  events      DomainTaskEvent[]
  reviewers   DomainTaskReviewer[]
  attachments DomainTaskAttachment[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}

/// Somebody asked to sign a task off.
///
/// A task can name several, and any one of them approving closes it —
/// they are a pool, not a chain. Which means the ones who never acted have
/// to stay visible: "three reviewers" reads as three opinions when it was
/// one, so every screen lists the whole set and marks who actually
/// decided.
///
/// Their decisions all reset to Pending when a task is sent back, because
/// the work that comes back is not the work anybody looked at.
///
/// Reviewing is deliberately not the assignment ladder. An Actionee cannot
/// hand work to their Lead, but should certainly be able to ask them to
/// check it, so anyone active can be named here.
/// Somebody's standing choice of reviewer.
///
/// A table rather than a list of ids on DomainUser, so a deleted account
/// cannot linger as a stale id that silently pre-fills a person who has
/// left — the cascade removes the nomination with the account.
///
/// Owner and reviewer are separate relations to the same table: "who set
/// this" and "who gets named".
model DomainDefaultReviewer {
  id         Int        @id @default(autoincrement())
  ownerId    String
  owner      DomainUser @relation("DefaultReviewerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   DomainUser @relation("DefaultReviewerPerson", fields: [reviewerId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())

  @@unique([ownerId, reviewerId])
  @@index([ownerId])
}

model DomainTaskReviewer {
  id        Int        @id @default(autoincrement())
  taskId    Int
  task      DomainTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      DomainUser @relation("DomainTaskReviewerUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Pending | Approved | Rejected
  decision  String     @default("Pending")
  decidedAt DateTime?
  note      String?
  createdAt DateTime   @default(now())

  @@unique([taskId, userId])
  @@index([userId, decision])
}

/// A file on a task — the brief when it was handed over, or the work when
/// it came back.
///
/// `side` is what keeps those apart on screen: a reviewer opening a task
/// needs to know which of five files is the spec and which is the answer.
///
/// Bytes live on disk under UPLOAD_DIR, exactly as the tracker's
/// attachments do, so both modules share one volume and one backup story.
/// Only the path is kept here.
model DomainTaskAttachment {
  id           Int         @id @default(autoincrement())
  taskId       Int
  task         DomainTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// Brief | Submission
  side         String      @default("Brief")
  name         String
  size         String
  kind         String      @default("other")
  storageKey   String?
  uploadedById String?
  uploadedBy   DomainUser? @relation("DomainTaskAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([taskId])
}

/// One entry in a task's history: who did what to it, when, and what they
/// said at the time.
///
/// Kept as its own table rather than read back off DomainTask, because the
/// task only ever holds the LATEST state — a resubmission clears the
/// previous decision so the next one starts clean. That is right for
/// "where does this stand", and useless for "what happened". A task
/// rejected twice and finally approved reads, on the task row alone, as
/// though it were approved first time.
///
/// Append-only: nothing here is ever updated or deleted, so the record of
/// a decision survives the decision being superseded.
model DomainTaskEvent {
  id     Int        @id @default(autoincrement())
  taskId Int
  task   DomainTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// Who did it. Kept even if they later leave — the history should not
  /// rewrite itself, so the account is restricted from deletion by this
  /// reference rather than nulled.
  actorId String
  actor   DomainUser @relation("DomainTaskEventActor", fields: [actorId], references: [id])

  /// Assigned | Reassigned | Submitted | Approved | Rejected
  kind String
  /// What was said at the time: the brief, the submission note, or the
  /// reviewer's reason. Null where the action carried no words.
  note String?
  /// Free context, e.g. who a task was moved to.
  detail String?

  at DateTime @default(now())

  @@index([taskId])
}

model DomainWorkLog {
  id        Int            @id @default(autoincrement())
  userId    String
  user      DomainUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId Int?
  project   DomainProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId    Int?
  task      DomainTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  date      DateTime // the IST day this log is for (midnight UTC of that date)
  hours     Float
  note      String
  createdAt DateTime       @default(now())

  @@index([userId, date])
}

/// A public holiday: a day nobody works, on top of the weekend.
///
/// Stored as one row per date rather than a recurring rule because Indian
/// public holidays move with the lunar calendar — Diwali is not "the same
/// date every year", so a rule would be wrong more often than right. A
/// short list an Admin types in once a year is both simpler and correct.
///
/// `date` is midnight UTC of the calendar day, matching DomainWorkLog.
model DomainHoliday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique
  name      String
  createdAt DateTime @default(now())

  @@index([date])
}

/// Attendance and time off for one person on one day.
///
/// Two ways a row appears, and the difference is who is allowed to do it:
///
///   - a supervisor MARKS someone — Admin, Lead or Team Lead recording
///     that a person was present, absent, or worked a half day. Marked by
///     someone with the authority to decide it, so it is Approved on
///     arrival.
///   - a worker REQUESTS time off — an SME or Actionee asking for a leave
///     or a half day. Starts Pending and does nothing until a supervisor
///     decides it.
///
/// One row per person per day (`@@unique`), because a day cannot be both
/// a full day present and a leave. Re-marking the same day updates the
/// row rather than stacking contradictions.
///
/// `hours` is only meaningful for a half day — how much of the day was
/// actually worked. Kept nullable rather than defaulted so "half day, we
/// never recorded how long" stays distinguishable from "half day, zero
/// hours".
model DomainLeave {
  id     Int    @id @default(autoincrement())
  userId String
  user   DomainUser @relation("DomainLeaveSubject", fields: [userId], references: [id], onDelete: Cascade)
  /// The IST day this covers (midnight UTC of that date), matching
  /// DomainWorkLog and DomainHoliday.
  date   DateTime
  /// Present | Absent | Half day | Leave
  kind   String
  /// Hours worked on a half day.
  hours  Float?
  note   String?
  /// Pending | Approved | Rejected
  status String @default("Pending")

  /// Who put the row there — the person themselves for a request, or the
  /// supervisor who marked it.
  createdById String
  createdBy   DomainUser @relation("DomainLeaveAuthor", fields: [createdById], references: [id])

  /// Who approved or rejected it, and when. Null while pending.
  decidedById String?
  decidedBy   DomainUser? @relation("DomainLeaveDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([status])
  @@index([date])
}
